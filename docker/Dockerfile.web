FROM golang:1.26.2-alpine AS builder

WORKDIR /build

RUN apk add --no-cache gcc musl-dev

# Copy EVERYTHING from project root (includes go.mod, go.sum, cmd/, internal/, etc.)
COPY . .

# Build only web-server
RUN CGO_ENABLED=1 GOOS=linux go build -ldflags="-w -s" \
    -o /build/web-server ./cmd/web-server

FROM alpine:latest

RUN apk --no-cache add ca-certificates tzdata
WORKDIR /app
COPY --from=builder /build/web-server .
RUN mkdir -p /data
EXPOSE 8080
CMD ["./web-server"]